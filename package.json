{
	"name": "family-hub",
	"private": true,
	"license": "Apache-2.0",
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:backup": "tsx scripts/backup.ts",
		"seed": "tsx scripts/seed.ts",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"tesserae:build-page": "tsx tesserae/scripts/build-page.ts"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.0.2",
		"better-sqlite3": "^12.0.0",
		"drizzle-orm": "^0.45.4",
		"node-ical": "0.27.3",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@phosphor-icons/core": "2.1.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-node": "^6.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"tsx": "^4.20.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"allowScripts": {
		"better-sqlite3@12.11.1": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true,
		"@node-rs/argon2@2.2.2": true
	}
}
